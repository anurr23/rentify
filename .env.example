# ==============================================================================
# Rentify — Template Kredensial & Konfigurasi
# Salin file ini menjadi .env lalu sesuaikan nilainya.
# ==============================================================================

# Environment aplikasi: development | production
APP_ENV=development

# Database (MySQL)
DB_HOST=127.0.0.1
DB_DOCKER_HOST=mysql-server
DB_PORT=3306
DB_NAME=rentify
DB_USER=root
DB_PASSWORD=

# AI / 9router
RENTIFY_AI_KEY=
RENTIFY_AI_BASE_URL=https://api.deepseek.com
RENTIFY_AI_DOCKER_BASE_URL=https://api.deepseek.com
RENTIFY_AI_MODEL=deepseek-chat
RENTIFY_AI_FALLBACK_MODEL=deepseek-chat
RENTIFY_AI_TIMEOUT=60
RENTIFY_AI_MAX_TOKENS=4096
