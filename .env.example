# ==============================================================================
# Rentify — Template Kredensial & Konfigurasi
# Salin file ini menjadi .env lalu sesuaikan nilainya.
# ==============================================================================

# Environment aplikasi: development | production
APP_ENV=development

# Database (MySQL)
DB_HOST=127.0.0.1
DB_DOCKER_HOST=mysql-server
DB_PORT=3306
DB_NAME=rentify
DB_USER=root
DB_PASSWORD=

# AI / 9router
RENTIFY_AI_KEY=
RENTIFY_AI_BASE_URL=http://localhost:20128/v1
RENTIFY_AI_DOCKER_BASE_URL=http://host.docker.internal:20128/v1
RENTIFY_AI_MODEL=ag/gemini-3.8-flash-medium
RENTIFY_AI_FALLBACK_MODEL=cl/google/gemini-3.8-flash
RENTIFY_AI_TIMEOUT=60
