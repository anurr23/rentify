{
  "name": "rentify",
  "version": "1.0.0",
  "private": true,
  "description": "Rentify Outdoor Karawang - platform rental perlengkapan outdoor",
  "scripts": {
    "build:css": "tailwindcss -i ./assets/css/app.css -o ./assets/css/tailwind.css --minify",
